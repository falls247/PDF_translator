# 秘密情報とローカル設定
.env
.env.*
!.env.example
!.env.sample

# 入出力データと実行済みファイル（ディレクトリ維持用の .gitkeep を除く）
/inputs/**
!/inputs/**/
!/inputs/**/.gitkeep
/outputs/**
!/outputs/**/
!/outputs/**/.gitkeep
/executed_files/**
!/executed_files/**/
!/executed_files/**/.gitkeep

# PDFファイル
*.[pP][dD][fF]

# Python環境とキャッシュ
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# エディタとOSの一時ファイル
.DS_Store
Thumbs.db
*.swp
*.swo
*~
